{
  "_version": 3,
  "cdp_port": 9222,
  "flow_start_url": "https://labs.google/fx/tools/flow",
  "flow_url_contains": [
    "flow.google",
    "labs.google/fx/tools/flow"
  ],
  "prompt_box": "div.ProseMirror, [role='textbox'][contenteditable='true']",
  "generate_btn": "Start generation|arrow_forward|^create$|^generate$",
  "generate_fallback_css": "button:has-text('Start generation'), button[aria-label*='Start generation' i], button[aria-label*='Generate' i]",
  "stop_btn": "Stop generation|^stop$|^cancel$",
  "tiles": "main img, main video",
  "min_tile_px": 120,
  "download_btn": "Download",
  "more_options_btn": "More options",
  "back_btn": "Back button to go to previous page|^back$|^close$",
  "close_detail_key": "Escape",
  "detail_url_parts": [
    "/edit/",
    "/view/"
  ],
  "busy_regex": "\\d{1,3}\\s*%",
  "error_patterns": [
    "something went wrong",
    "generation failed",
    "unable to generate",
    "couldn't generate",
    "can't generate",
    "failed to generate",
    "policy violation",
    "content violation",
    "violates our",
    "violates terms",
    "harmful content",
    "safety guidelines",
    "safety policy",
    "prohibited content",
    "flagged",
    "quota exceeded",
    "too many requests",
    "rate limit",
    "daily limit",
    "out of credits",
    "no credits remaining",
    "credit balance",
    "try a different prompt",
    "an error occurred",
    "request failed",
    "server error"
  ],
  "settle_s": 3,
  "button_ready_timeout_s": 45,
  "idle_timeout_s": 45,
  "max_retries_per_prompt": 2,
  "ref_image_input": "input[type='file'][accept*='image'], input[type='file']",
  "ref_image_btn": "button[aria-label*='image' i], button[aria-label*='upload' i], button[aria-label*='reference' i], button[aria-label*='attach' i], button:has-text('Add image'), button:has-text('Upload')",
  "ref_image_chip": "[role='region'] img, .chip img, [aria-label*='image' i] img, div.ProseMirror ~ * img, button[aria-label*='Remove' i], button[aria-label*='Delete' i]"
}
